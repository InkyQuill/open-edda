      "kind": "button",
      "refersTo": "icon-button",
      "description": "Named icon action from the production Edda interface.",
      "html": "<button class=\"ds-icon\" aria-label=\"Создать файл\" title=\"Создать файл\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;padding:0;border:0;border-radius:8px;background:transparent;color:var(--edda-muted,#667169);cursor:pointer}.ds-icon:hover{background:var(--hover,#e8ede5);color:var(--accent-ink,#234d3c)}.ds-icon:focus-visible{outline:2px solid var(--edda-accent,#376452);outline-offset:3px}"
    },
