      "css": ".ds-quiet{font:500 12px \"Geist Variable\",sans-serif;padding:10px 14px;min-height:40px;border:0;border-radius:8px;background:var(--hover,#e8ede5);color:var(--accent-ink,#234d3c);cursor:pointer}.ds-quiet:hover{background:var(--selected,#dce9e0)}.ds-quiet:focus-visible{outline:2px solid var(--edda-accent,#376452);outline-offset:3px}"
    },
