      "css": ".ds-field{display:flex;flex-direction:column;gap:9px;font:12px \"Geist Variable\",sans-serif;color:var(--ink,#293831)}.ds-field input{padding:11px 12px;min-height:42px;border:1px solid var(--line,#dce1d9);border-radius:6px;background:var(--paper,#fcfcf8);color:var(--ink,#293831);font:14px \"Geist Variable\",sans-serif}.ds-field input::placeholder{color:var(--edda-muted,#667169)}.ds-field input:focus-visible{outline:2px solid var(--edda-accent,#376452);outline-offset:3px}"
